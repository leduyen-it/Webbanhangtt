    <!-- Cart Start -->
    <div class="cart-page">
      <div class="container-fluid">
        <div class="row">
          <div class="col-lg-8">
            <div class="cart-page-inner">
              <div class="table-responsive">
                <table class="table table-bordered">
                  <thead class="thead-dark">
                    <tr>
                      <th>
                        <input
                          type="checkbox"
                          id="selectAll"
                          onchange="selectAllItems()"
                        />
                      </th>
                      <th>Tên sản phẩm</th>
                      <th>Giá</th>
                      <th>Số lượng</th>
                      <th>Tổng</th>
                      <th>Xóa</th>
                    </tr>
                  </thead>
                  <tbody class="align-middle">
                    <% if (cartItems && cartItems.length > 0) { %> <% for (let
                    item of cartItems) { %>
                    <tr class="cart-item-row">
                      <td>
                        <input
                          type="checkbox"
                          class="item-checkbox"
                          data-cart-id="<%= item.idCart %>"
                          data-price="<%= item.priceProduct %>"
                          data-quantity="<%= item.quantity %>"
                          onchange="updateTotal()"
                        />
                      </td>
                      <td data-label="Sản phẩm">
                        <div class="img">
                          <a
                            href="/san-pham/<%= item.nameProduct.toLowerCase().replace(/\s+/g, '-').replace(/[àáạảãâầấậẩẫăằắặẳẵ]/g, 'a').replace(/[èéẹẻẽêềếệểễ]/g, 'e').replace(/[ìíịỉĩ]/g, 'i').replace(/[òóọỏõôồốộổỗơờớợởỡ]/g, 'o').replace(/[ùúụủũưừứựửữ]/g, 'u').replace(/[ỳýỵỷỹ]/g, 'y').replace(/đ/g, 'd') %>"
                            ><img src="/<%=item.imgProduct%>" alt="Image"
                          /></a>
                          <p><%= item.nameProduct%></p>
                        </div>
                      </td>
                      <td data-label="Giá"><%=item.priceProduct.toLocaleString()%> đ</td>
                      <td data-label="Số lượng">
                        <div class="qty">
                          <button
                            class="btn-minus qty-btn"
                            data-cart-id="<%= item.idCart %>"
                          >
                            <i class="fa fa-minus"></i>
                          </button>
                          <input
                            type="text"
                            value="<%= item.quantity %>"
                            readonly
                          />
                          <button
                            class="btn-plus qty-btn"
                            data-cart-id="<%= item.idCart %>"
                          >
                            <i class="fa fa-plus"></i>
                          </button>
                        </div>
                      </td>
                      <td data-label="Tổng">
                        <%=(item.quantity *
                        item.priceProduct).toLocaleString()%> đ
                      </td>
                      <td data-label="Xóa">
                        <button
                          class="remove-from-cart delete-btn"
                          data-cart-id="<%= item.idCart %>"
                        >
                          <i class="fa fa-trash"></i>
                        </button>
                      </td>
                    </tr>
                    <% } %> <% } else { %>
                    <tr>
                      <td colspan="6" class="text-center empty-cart">
                        <i class="fa fa-shopping-basket" aria-hidden="true"></i>
                        <p>Giỏ hàng trống</p>
                        <a href="/san-pham" class="btn btn-primary"
                          >Tiếp tục mua sắm</a
                        >
                      </td>
                    </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
          <div class="col-lg-4">
            <div class="cart-page-inner">
              <div class="row">
                <div class="col-md-12">
                  <div class="coupon">
                    <input type="text" placeholder="Mã giảm giá" />
                    <button>Áp dụng</button>
                  </div>
                </div>
                <div class="col-md-12">
                  <div class="cart-summary">
                    <div class="cart-content">
                      <h1>Thống kê giỏ hàng</h1>
                      <p>
                        Tổng tiền sản phẩm<span id="subtotal"
                          ><%= (cartTotal || 0).toLocaleString() %> đ</span
                        >
                      </p>
                      <p>Phí ship<span id="shipping">0 đ</span></p>
                      <h2>
                        Tổng cộng<span id="total"
                          ><%= ((cartTotal || 0) + 30000).toLocaleString() %>
                          đ</span
                        >
                      </h2>
                    </div>
                    <div class="cart-btn">
                      <% if (cartItems && cartItems.length > 0) { %>
                      <button
                        onclick="checkout()"
                        class="btn btn-primary"
                        id="checkoutBtn"
                      >
                        Thanh Toán
                      </button>
                      <% } else { %>
                      <button class="btn btn-secondary" disabled>
                        Giỏ hàng trống
                      </button>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
