    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.bundle.min.js"></script>
    <script src="../lib/easing/easing.min.js"></script>
    <script src="../lib/slick/slick.min.js"></script>

    <!-- Template Javascript -->
    <script src="../js/main.js"></script>
    <script>
      function updateQuantity(cartId, newQuantity) {
        if (newQuantity < 1) {
          // Khi giảm về 0, tự động xóa sản phẩm
          removeFromCart(cartId);
          return;
        }

        // Kiểm tra nếu đang update rồi thì bỏ qua
        if (window.cartUpdating) return;
        window.cartUpdating = true;

        // Cập nhật data-quantity của checkbox ngay lúc này
        const checkbox = document.querySelector(`.item-checkbox[data-cart-id="${cartId}"]`);
        if (checkbox) {
          checkbox.dataset.quantity = newQuantity;
          // Cập nhật tổng tiền ngay lúc này (nếu sản phẩm được chọn)
          updateTotal();
        }

        // Lưu trạng thái checkbox trước khi update
        saveCheckboxState();

        $.ajax({
          url: "/cart/update",
          method: "POST",
          data: {
            idCart: cartId,
            quantity: newQuantity,
          },
          success: function (response) {
            if (response.success) {
              // Cập nhật giá trị input trong bảng mà không reload
              const inputElement = document.querySelector(
                `.qty-btn[data-cart-id="${cartId}"]`
              ).parentElement.querySelector("input");
              if (inputElement) {
                inputElement.value = newQuantity;
              }
              
              // Cập nhật cột Tổng trong bảng
              const totalCell = document.querySelector(
                `.item-checkbox[data-cart-id="${cartId}"]`
              ).closest("tr").querySelector("td:nth-child(5)");
              if (totalCell && checkbox) {
                const price = Number(checkbox.dataset.price);
                totalCell.textContent = (price * newQuantity).toLocaleString() + " đ";
              }

              window.cartUpdating = false;
            } else {
              alert(response.message);
              window.cartUpdating = false;
            }
          },
          error: function () {
            alert("Lỗi khi cập nhật số lượng");
            window.cartUpdating = false;
          },
        });
      }

      // Function để xóa sản phẩm khỏi giỏ hàng
      function removeFromCart(cartId) {
        // Kiểm tra nếu đang update rồi thì bỏ qua
        if (window.cartUpdating) return;
        window.cartUpdating = true;

        $.ajax({
          url: "/cart/remove",
          method: "POST",
          data: {
            idCart: cartId,
          },
          success: function (response) {
            if (response.success) {
              // Xóa dòng sản phẩm khỏi bảng mà không reload
              const row = document.querySelector(`.item-checkbox[data-cart-id="${cartId}"]`).closest("tr");
              if (row) {
                row.style.transition = "opacity 0.3s ease";
                row.style.opacity = "0";
                setTimeout(() => {
                  row.remove();
                  
                  // Kiểm tra nếu giỏ hàng trống thì reload để hiển thị "Giỏ hàng trống"
                  const itemsRemaining = document.querySelectorAll(".item-checkbox").length;
                  if (itemsRemaining === 0) {
                    location.reload();
                  } else {
                    // Cập nhật tổng tiền
                    updateTotal();
                    window.cartUpdating = false;
                  }
                }, 300);
              }
            } else {
              alert(response.message || "Có lỗi xảy ra khi xóa sản phẩm");
              window.cartUpdating = false;
            }
          },
          error: function () {
            alert("Có lỗi xảy ra khi xóa sản phẩm khỏi giỏ hàng");
            window.cartUpdating = false;
          },
        });
      }

      // Function để chọn/bỏ chọn tất cả sản phẩm
      function selectAllItems() {
        const selectAllCheckbox = document.getElementById("selectAll");
        const itemCheckboxes = document.querySelectorAll(".item-checkbox");

        itemCheckboxes.forEach((checkbox) => {
          checkbox.checked = selectAllCheckbox.checked;
        });

        updateTotal();
      }

      // Function để cập nhật tổng tiền
      function updateTotal() {
        const allItemCheckboxes = document.querySelectorAll(".item-checkbox");
        const itemCheckboxes = document.querySelectorAll(".item-checkbox:checked");
        const selectAllCheckbox = document.getElementById("selectAll");

        if (selectAllCheckbox) {
          selectAllCheckbox.checked =
            allItemCheckboxes.length > 0 &&
            itemCheckboxes.length === allItemCheckboxes.length;
        }

        let subtotal = 0;

        itemCheckboxes.forEach((checkbox) => {
          const price = Number(checkbox.dataset.price);
          const quantity = parseInt(checkbox.dataset.quantity);
          subtotal += price * quantity;
        });

        const shipping = itemCheckboxes.length > 0 ? 30000 : 0;
        const total = subtotal + shipping;

        // Cập nhật hiển thị
        document.getElementById("subtotal").textContent =
          subtotal.toLocaleString() + " đ";
        document.getElementById("shipping").textContent =
          shipping.toLocaleString() + " đ";
        document.getElementById("total").textContent =
          total.toLocaleString() + " đ";

        // Vô hiệu hóa nút thanh toán nếu không có sản phẩm nào được chọn
        const checkoutBtn = document.getElementById("checkoutBtn");
        if (checkoutBtn) {
          checkoutBtn.disabled = itemCheckboxes.length === 0;
          checkoutBtn.classList.toggle('btn-secondary', itemCheckboxes.length === 0);
          checkoutBtn.classList.toggle('btn-primary', itemCheckboxes.length > 0);
          checkoutBtn.textContent =
            itemCheckboxes.length === 0
              ? "Chọn sản phẩm để thanh toán"
              : "Thanh Toán (" + itemCheckboxes.length + " sản phẩm)";
        }

        // Cập nhật trạng thái nút tăng giảm số lượng
        updateQuantityButtonsState();
      }

      // Function để cập nhật trạng thái các nút xóa và tăng/giảm
      function updateQuantityButtonsState() {
        const allCheckboxes = document.querySelectorAll(".item-checkbox");
        allCheckboxes.forEach((checkbox) => {
          const cartId = checkbox.dataset.cartId;
          const deleteBtn = document.querySelector(
            `.delete-btn[data-cart-id="${cartId}"]`
          );
          const qtyBtns = document.querySelectorAll(`.qty-btn[data-cart-id="${cartId}"]`);

          if (deleteBtn) {
            deleteBtn.disabled = checkbox.checked;
            deleteBtn.style.opacity = checkbox.checked ? "0.5" : "1";
            deleteBtn.style.cursor = checkbox.checked ? "not-allowed" : "pointer";
            deleteBtn.style.pointerEvents = checkbox.checked ? "none" : "auto";
          }

          if (checkbox.checked) {
            qtyBtns.forEach(btn => {
              btn.style.opacity = "0.5";
              btn.style.cursor = "not-allowed";
              btn.style.pointerEvents = "none";
              btn.disabled = true;
            });
          } else {
            qtyBtns.forEach(btn => {
              btn.style.opacity = "1";
              btn.style.cursor = "pointer";
              btn.style.pointerEvents = "auto";
              btn.disabled = false;
            });
          }
        });
      }

      // Function để xử lý thanh toán chỉ các sản phẩm được chọn
      function checkout() {
        const selectedItems = document.querySelectorAll(
          ".item-checkbox:checked"
        );

        if (selectedItems.length === 0) {
          alert("Vui lòng chọn ít nhất một sản phẩm để thanh toán");
          return;
        }

        const selectedCartIds = Array.from(selectedItems).map(
          (checkbox) => checkbox.dataset.cartId
        );

        // Chuyển hướng đến trang thanh toán với các sản phẩm đã chọn
        window.location.href = "/thanh-toan?items=" + selectedCartIds.join(",");
      }

      // Khởi tạo khi trang load
      document.addEventListener("DOMContentLoaded", function () {
        // Khởi tạo flag để tránh double click
        window.cartUpdating = false;

        // Xóa tất cả event listeners cũ từ main.js để tránh conflict
        const oldQtyButtons = document.querySelectorAll(".qty-btn");
        oldQtyButtons.forEach(btn => {
          const newBtn = btn.cloneNode(true);
          btn.parentNode.replaceChild(newBtn, btn);
        });

        // Khôi phục trạng thái checkbox từ localStorage
        restoreCheckboxState();
        updateTotal();

        // Gắn event listeners chỉ một lần bằng event delegation để tránh nhảy 2 cái
        if (!window.cartEventListenersAttached) {
          // Event listener cho nút tăng/giảm số lượng và xóa
          document.addEventListener("click", function (e) {
            // Nếu đang update, bỏ qua toàn bộ click event
            if (window.cartUpdating) return;

            const btn = e.target.closest(".qty-btn");
            if (btn) {
              e.preventDefault();
              e.stopPropagation(); // Ngăn event bubble lên

              // Nếu nút bị disable, bỏ qua
              if (btn.disabled) return;

              const cartId = btn.getAttribute("data-cart-id");
              const isMinusBtn = btn.classList.contains("btn-minus");
              
              // Lấy giá trị hiện tại từ input tương ứng
              const input = btn.parentElement.querySelector("input");
              let quantity = parseInt(input.value);
              
              if (isMinusBtn) {
                quantity--; // Cho phép giảm xuống 0
                if (quantity < 0) quantity = 0;
              } else {
                quantity++;
              }
              
              updateQuantity(cartId, quantity);
              return; // Thoát để tránh tiếp tục xử lý
            }

            // Event listener cho nút xóa
            const deleteBtn = e.target.closest(".delete-btn");
            if (deleteBtn) {
              e.preventDefault();
              e.stopPropagation(); // Ngăn event bubble lên

              const cartId = deleteBtn.getAttribute("data-cart-id");
              removeFromCart(cartId);
            }
          }, true); // Capture phase để chắc chắn xử lý trước các listener khác

          window.cartEventListenersAttached = true;
        }
      });

      // Function để lưu trạng thái checkbox vào localStorage
      function saveCheckboxState() {
        const selectedItems = [];
        const selectAllChecked = document.getElementById("selectAll").checked;
        
        document.querySelectorAll(".item-checkbox:checked").forEach((checkbox) => {
          selectedItems.push(checkbox.dataset.cartId);
        });

        localStorage.setItem("selectedCartItems", JSON.stringify(selectedItems));
        localStorage.setItem("selectAllChecked", selectAllChecked);
      }

      // Function để khôi phục trạng thái checkbox từ localStorage
      function restoreCheckboxState() {
        const selectedItems = JSON.parse(localStorage.getItem("selectedCartItems") || "[]");
        const selectAllChecked = localStorage.getItem("selectAllChecked") === "true";

        if (selectedItems.length > 0) {
          selectedItems.forEach((cartId) => {
            const checkbox = document.querySelector(`.item-checkbox[data-cart-id="${cartId}"]`);
            if (checkbox) {
              checkbox.checked = true;
            }
          });

          // Cập nhật selectAll checkbox
          const allCheckboxes = document.querySelectorAll(".item-checkbox");
          const checkedCheckboxes = document.querySelectorAll(".item-checkbox:checked");
          document.getElementById("selectAll").checked = 
            allCheckboxes.length > 0 && allCheckboxes.length === checkedCheckboxes.length;
        } else if (selectAllChecked) {
          document.getElementById("selectAll").checked = true;
          selectAllItems();
        }
      }

      // Lưu trạng thái khi người dùng thay đổi checkbox
      document.addEventListener("change", function(e) {
        if (e.target.classList.contains("item-checkbox") || e.target.id === "selectAll") {
          saveCheckboxState();
        }
      });
    </script>
  </body>
</html>
