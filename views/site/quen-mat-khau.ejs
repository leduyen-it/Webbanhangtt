<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quên mật khẩu - Helmet Store</title>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet" />
    <link href="../css/style.css" rel="stylesheet" />
    <link href="../css/premium.css" rel="stylesheet" />
    <style>
      .recovery-card { max-width: 520px; margin: 55px auto; padding: 32px; background: #fff; box-shadow: 0 8px 28px rgba(0,0,0,.08); border-radius: 8px; }
      .recovery-card h1 { font-size: 1.7rem; margin-bottom: 12px; }
      .recovery-card .btn { min-width: 150px; }
    </style>
  </head>
  <body>
    <div class="nav">
      <div class="container-fluid">
        <nav class="navbar navbar-expand-md bg-dark navbar-dark">
          <a href="/" class="navbar-brand">Helmet Store</a>
          <div class="navbar-nav ml-auto">
            <a href="/users/dang-nhap" class="nav-item nav-link">Đăng nhập</a>
          </div>
        </nav>
      </div>
    </div>
    <main class="container">
      <section class="recovery-card">
        <h1 class="text-center">Quên mật khẩu</h1>
        <p class="text-muted text-center">Nhập email đã đăng ký. Nếu email hợp lệ, chúng tôi sẽ gửi mã OTP để xác thực.</p>
        <% if (message) { %>
          <div class="alert alert-<%= messageType === 'success' ? 'success' : messageType === 'warning' ? 'warning' : 'danger' %>" role="alert"><%= message %></div>
        <% } %>
        <form action="/users/quen-mat-khau" method="post">
          <div class="form-group">
            <label for="email">Địa chỉ email</label>
            <input id="email" name="email" class="form-control" type="email" autocomplete="email" required maxlength="254" />
          </div>
          <button class="btn btn-primary btn-block" type="submit">Gửi mã OTP</button>
        </form>
        <p class="text-center mt-3 mb-0"><a href="/users/dang-nhap">Quay lại đăng nhập</a></p>
      </section>
    </main>
  </body>
</html>
