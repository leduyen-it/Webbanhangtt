    <!-- Login Start -->
    <div class="login">
      <div class="container-fluid">
        <div class="row">
          <div class="col-lg-6 mx-auto">
            <div class="register-form">
              <form id="registerForm" action="/users/luu" method="post" novalidate>
                <div class="row">
                  <legend class="text-center">ĐĂNG KÝ</legend>
                  <div class="col-md-6">
                    <label for="ho">Họ <span class="text-danger">*</span></label>
                    <input
                      id="ho"
                      name="ho"
                      class="form-control"
                      type="text"
                      placeholder="Họ"
                      required
                      minlength="2"
                      autocomplete="off"
                    />
                    <small class="form-text text-danger d-none" id="hoError"></small>
                  </div>
                  <div class="col-md-6">
                    <label for="ten">Tên <span class="text-danger">*</span></label>
                    <input
                      id="ten"
                      name="ten"
                      class="form-control"
                      type="text"
                      placeholder="Tên"
                      required
                      minlength="2"
                      autocomplete="off"
                    />
                    <small class="form-text text-danger d-none" id="tenError"></small>
                  </div>
                  <div class="col-md-12">
                    <label for="username">Tên Đăng Nhập <span class="text-danger">*</span></label>
                    <input
                      id="username"
                      name="username"
                      class="form-control"
                      type="text"
                      placeholder="Username"
                      required
                      minlength="3"
                      pattern="[a-zA-Z0-9_]+"
                      autocomplete="username"
                    />
                    <small class="form-text text-danger d-none" id="usernameError"></small>
                    <small class="form-text text-muted">Chỉ chứa chữ, số và dấu gạch dưới</small>
                  </div>
                  <div class="col-md-6">
                    <label for="email">E-mail <span class="text-danger">*</span></label>
                    <input
                      id="email"
                      name="email"
                      class="form-control"
                      type="email"
                      placeholder="E-mail"
                      required
                    />
                    <small class="form-text text-danger d-none" id="emailError"></small>
                  </div>
                  <div class="col-md-6">
                    <label for="phone">Số Điện Thoại <span class="text-danger">*</span></label>
                    <input
                      id="phone"
                      name="phone"
                      class="form-control"
                      type="tel"
                      placeholder="0123456789"
                      required
                      pattern="0[0-9]{9}"
                      autocomplete="off"
                    />
                    <small class="form-text text-danger d-none" id="phoneError"></small>
                    <small class="form-text text-muted">Định dạng: 0xxxxxxxxx (10 số)</small>
                  </div>
                  <div class="col-md-6">
                    <label for="password">Mật Khẩu <span class="text-danger">*</span></label>
                    <div style="position: relative;">
                      <input
                        id="password"
                        name="password"
                        class="form-control"
                        type="password"
                        placeholder="Nhập mật khẩu của bạn"
                        required
                        minlength="6"
                        autocomplete="current-password"
                        style="padding-right: 40px;"
                      />
                      <i class="fas fa-eye toggle-password" id="togglePassword" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #999; pointer-events: auto;"></i>
                    </div>
                    <small class="form-text text-danger d-none" id="passwordError"></small>
                    <small class="form-text text-muted">Tối thiểu 6 ký tự</small>
                  </div>
                  <div class="col-md-6">
                    <label for="retype">Nhập Lại Mật Khẩu <span class="text-danger">*</span></label>
                    <div style="position: relative;">
                      <input
                        id="retype"
                        name="retypePassword"
                        class="form-control"
                        type="password"
                        placeholder="Nhập lại mật khẩu"
                        required
                        autocomplete="new-password"
                        style="padding-right: 40px;"
                      />
                      <i class="fas fa-eye toggle-password" id="toggleRetype" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #999; pointer-events: auto;"></i>
                    </div>
                    <small class="form-text text-danger d-none" id="retypeError"></small>
                  </div>
                  <div class="col-md-12">
                    <label for="address">Địa chỉ <span class="text-danger">*</span></label>
                    <input
                      id="address"
                      name="address"
                      class="form-control"
                      type="text"
                      placeholder="Địa chỉ"
                      required
                      minlength="5"
                      autocomplete="off"
                    />
                    <small class="form-text text-danger d-none" id="addressError"></small>
                  </div>
                  <div class="col-md-12 text-center">
                    <button type="submit" class="btn">Đăng ký</button>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
