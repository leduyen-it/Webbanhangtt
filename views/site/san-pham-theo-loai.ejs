      var totalProducts = $("#myTable .col-md-4").length;
      var visibleProducts = $("#myTable .col-md-4:visible").length;
      console.log("=== Check No Results ===");
      console.log("Total products:", totalProducts);
      console.log("Visible products:", visibleProducts);
      
      if (totalProducts === 0) {
        console.log("WARNING: No products loaded yet!");
        return;
      }
      
      if (visibleProducts === 0) {
        console.log("✓ Showing no result message");
        $("#noResultMessage").css("display", "block").show();
      } else {
        console.log("✓ Hiding no result message");
        $("#noResultMessage").hide();
      }
    }

    // Search functionality cho ô tìm kiếm trong trang
    $("#myInput").on("keyup", function () {
      var value = $(this).val().toLowerCase().trim();
      console.log("=== myInput Search ===");
      console.log("Search value:", value);
      
      $("#myTable .col-md-4").filter(function () {
        var isMatch = value === '' || $(this).text().toLowerCase().indexOf(value) > -1;
        $(this).toggle(isMatch);
      });
      
      setTimeout(checkNoResults, 50);
    });

    // Search functionality cho ô tìm kiếm trên header
    $("#headerSearch").on("keyup", function () {
      var value = $(this).val().toLowerCase().trim();
      console.log("=== headerSearch Search ===");
      console.log("Search value:", value);
      
      $("#myTable .col-md-4").filter(function () {
        var isMatch = value === '' || $(this).text().toLowerCase().indexOf(value) > -1;
        $(this).toggle(isMatch);
      });
      
      setTimeout(checkNoResults, 50);
    });

    // Xử lý submit form search trên header
    $("#headerSearchForm").on("submit", function (e) {
      e.preventDefault();
      var value = $("#headerSearch").val().toLowerCase().trim();
      console.log("=== headerSearchForm Submit ===");
      console.log("Search value:", value);
      
      if (value === '') {
        $("#myTable .col-md-4").show();
        $("#noResultMessage").hide();
        // Xóa query parameter khỏi URL
        window.history.pushState({}, '', window.location.pathname);
        return;
      }
      
      // Cập nhật URL với query parameter
      const newUrl = window.location.pathname + '?search=' + encodeURIComponent(value);
      window.history.pushState({}, '', newUrl);
      
      $("#myTable .col-md-4").filter(function () {
        var isMatch = $(this).text().toLowerCase().indexOf(value) > -1;
        $(this).toggle(isMatch);
      });
      
      setTimeout(checkNoResults, 50);
    });

    // Xử lý click nút search trên header (fallback)
    $("#headerSearchBtn").on("click", function (e) {
      e.preventDefault();
      $("#headerSearchForm").submit();
    });

    // Sort functionality
    $(".product-short .dropdown-item").on("click", function (e) {
      e.preventDefault();
      var sortType = $(this).text();
      sortProducts(sortType);
      $(".product-short .dropdown-toggle").text(sortType);
    });

    // Price filter functionality
    $(".product-price-range .dropdown-item").on("click", function (e) {
      e.preventDefault();
      var priceRange = $(this).text();
      filterByPrice(priceRange);
      $(".product-price-range .dropdown-toggle").text(priceRange);
    });
  });

  function sortProducts(sortType) {
    var container = $("#myTable");
    var products = container.children(".col-md-4").get();

    products.sort(function (a, b) {
      if (sortType === "Mới nhất") {
        return 0; // Giữ thứ tự hiện tại
      } else if (sortType === "Phổ biến" || sortType === "Bán chạy nhất") {
        return Math.random() - 0.5; // Random sort
      }
      return 0;
    });

    $.each(products, function (index, item) {
      container.append(item);
    });
  }

  function filterByPrice(priceRange) {
    var minPrice = 0;
    var maxPrice = Infinity;

    if (priceRange === "0 ₫ - 500.000 ₫") {
      minPrice = 0;
      maxPrice = 500000;
    } else if (priceRange === "500.000 ₫ - 1.000.000 ₫") {
      minPrice = 500000;
      maxPrice = 1000000;
    } else if (priceRange === "1.000.000 ₫ - 2.000.000 ₫") {
      minPrice = 1000000;
      maxPrice = 2000000;
    } else if (priceRange === "2.000.000 ₫ - 5.000.000 ₫") {
      minPrice = 2000000;
      maxPrice = 5000000;
    } else if (priceRange === "Trên 5.000.000 ₫") {
      minPrice = 5000000;
      maxPrice = Infinity;
    } else {
      // "Sắp xếp theo giá" - hiện tất cả
      $("#myTable .col-md-4").show();
      return;
    }

    $("#myTable .col-md-4").each(function () {
      var priceText = $(this).find(".product-price h3").text();
      var price = parseInt(priceText.replace(/[^\d]/g, ""));

      if (price >= minPrice && price <= maxPrice) {
        $(this).show();
      } else {
        $(this).hide();
      }
    });
  }
</script>
