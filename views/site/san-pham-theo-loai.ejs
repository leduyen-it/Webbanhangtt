<script>
  // Read product data from JSON script tag
  const productDataElement = document.getElementById('productData');
  const listPro = productDataElement ? JSON.parse(productDataElement.textContent) : [];

  // Read wishlist data from JSON script tag
  const wishlistDataElement = document.getElementById('wishlistData');
  const userWishlistIds = wishlistDataElement ? JSON.parse(wishlistDataElement.textContent) : [];

  const xuLyDuLieu = (data, id) => {
    const sp_theo_loai = document.getElementById("myTable");
    console.log("=== xuLyDuLieu called ===");
    console.log("Total products to render:", data.length);
    let str = ``;
    for (i in data) {
      let product = data[i];
      let newName = replaceNameProduct(product.nameProduct).toLowerCase();

      str += `<div class="col-md-4">
                <div class="product-item">
                    <div class="product-title">
                        <a class="slug" href="/san-pham/${newName}">${
        product.nameProduct
      }</a>
                        <div class="ratting">
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                        </div>
                    </div>
                    <div class="product-image">
                        <a href="/san-pham/${replaceNameProduct(
                          product.nameProduct
                        )}">
                            <img src="../${
                              product.imgProduct
                            }" alt="Product Image" width="100%">
                        </a>
              <div class="product-action" data-product-id="${
                product.idProduct
              }">
                  <a href="#" class="add-to-cart" data-product-id="${
                    product.idProduct
                  }"><i class="fa fa-cart-plus"></i></a>
                  <a href="#" class="add-to-wishlist" data-product-id="${
                    product.idProduct
                  }"><i class="${
                    window.userWishlistIds && window.userWishlistIds.includes(product.idProduct) ? 'fas' : 'far'
                  } fa-heart"></i></a>
                  <a href="/san-pham/${replaceNameProduct(
                    product.nameProduct
                  ).toLowerCase()}"><i class="fa fa-search"></i></a>
                </div>
                    </div>
                    <div class="product-price">
                        <h3>${product.priceProduct.toLocaleString(
                          "vi-VN"
                        )}<span> ₫</span></h3>
                        <a class="btn add-to-cart" href="#" data-product-id="${
                          product.idProduct
                        }"><i class="fa fa-shopping-cart"></i>Mua Ngay</a>
                    </div>
                </div>
            </div>`;
    }
    sp_theo_loai.innerHTML += str;

    console.log("Products rendered successfully");
    console.log("Total .col-md-4 elements:", $("#myTable .col-md-4").length);

    // Reinitialize search/filter after data is loaded
    setTimeout(function () {
      console.log("Initializing product filters...");
      initializeProductFilters();
    }, 100);
  };

  function initializeProductFilters() {
    // Function để kiểm tra và hiển thị thông báo
    function checkAndShowNoResultMessage() {
      var visibleProducts = $("#myTable .col-md-4:visible").length;
      console.log("Visible products:", visibleProducts);
      
      if (visibleProducts === 0) {
        console.log("Showing no result message");
        $("#noResultMessage").show();
      } else {
        console.log("Hiding no result message");
        $("#noResultMessage").hide();
      }
    }

    // Tìm kiếm sản phẩm trong trang danh mục (myInput)
    $("#myInput")
      .off("keyup")
      .on("keyup", function () {
        var value = $(this).val().toLowerCase().trim();
        console.log("Searching for:", value);
        
        $("#myTable .col-md-4").filter(function () {
          var productText = $(this).text().toLowerCase();
          var isMatch = value === '' || productText.indexOf(value) > -1;
          $(this).toggle(isMatch);
        });
        
        checkAndShowNoResultMessage();
      });

    // Tìm kiếm sản phẩm từ header search
    $("#headerSearch")
      .off("keyup")
      .on("keyup", function () {
        var value = $(this).val().toLowerCase().trim();
        console.log("Header search:", value);
        
        $("#myTable .col-md-4").filter(function () {
          var productText = $(this).text().toLowerCase();
          var isMatch = value === '' || productText.indexOf(value) > -1;
          $(this).toggle(isMatch);
        });
        
        checkAndShowNoResultMessage();
      });

    // Xử lý click nút search trên header
    $("#headerSearchBtn")
      .off("click")
      .on("click", function (e) {
        e.preventDefault();
        var value = $("#headerSearch").val().toLowerCase().trim();
        console.log("Header button clicked, searching:", value);
        
        if (value === '') {
          // Nếu rỗng, hiển thị tất cả sản phẩm
          $("#myTable .col-md-4").show();
          $("#noResultMessage").hide();
          return;
        }
        
        $("#myTable .col-md-4").filter(function () {
          var productText = $(this).text().toLowerCase();
          var isMatch = productText.indexOf(value) > -1;
          $(this).toggle(isMatch);
        });
        
